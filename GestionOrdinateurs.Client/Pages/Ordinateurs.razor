@page "/ordinateurs"
@using System.Net.Http.Json
@using GestionOrdinateurs.Shared
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Ordinateurs</PageTitle>

<h1>Ordinateurs</h1>

@if (loading)
{
    <p>Chargement...</p>
}
else if (errorMessage is not null)
{
    <p class="text-danger">@errorMessage</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Devise</th>
                <th>Vendu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ordinateur in ordinateurs)
            {
                <tr>
                    <td>@ordinateur.Nom</td>
                    <td>@ordinateur.Prix.ToString("F2")</td>
                    <td>EUR</td>
                    <td>@(ordinateur.Vendu ? "Oui" : "Non")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Ordinateur> ordinateurs = new();
    private string? errorMessage;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("GestionOrdinateursApi");
            var result = await client.GetFromJsonAsync<List<Ordinateur>>(
                "api/Ordinateurs");
            ordinateurs = result ?? new List<Ordinateur>();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de charger les ordinateurs.";
        }
        finally
        {
            loading = false;
        }
    }

}
